          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total{job=\"habit-tracker-backend\"}, route)",
          "refId": "route"
        },
        "definition": "label_values(http_requests_total{job=\"habit-tracker-backend\"}, route)",
